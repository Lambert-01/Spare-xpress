<script>const io=new IntersectionObserver((entries)=>{entries.forEach(en=>{if(!en.isIntersecting)return;const img=en.target,wrap=img.parentElement;img.onload=()=>wrap.classList.add('lz-ok');img.onerror=()=>wrap.classList.add('lz-no');img.src=img.dataset.src;io.unobserve(img)})},{rootMargin:'100px'});document.querySelectorAll('.lazy').forEach(img=>{if(img.parentElement?.classList.contains('lz-wr'))return;const wrap=document.createElement('div');wrap.className='lz-wr';img.parentNode.insertBefore(wrap,img);wrap.appendChild(img);wrap.addEventListener('click',(e)=>{if(!wrap.classList.contains('lz-no'))return;e.preventDefault();e.stopPropagation();wrap.classList.remove('lz-no');img.src=img.dataset.src+'?t='+Date.now()});io.observe(img)});</script>
<script>const html=document.documentElement;const btn=document.getElementById('theme-toggle');const getTheme=()=>{const theme=localStorage.getItem('theme');return theme||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light')};const setTheme=(theme)=>{html.setAttribute('data-theme',theme);localStorage.setItem('theme',theme)};setTheme(getTheme());btn.addEventListener('click',()=>{const isDark=html.getAttribute('data-theme')==='dark';setTheme(isDark?'light':'dark')});const mediaQuery=window.matchMedia('(prefers-color-scheme:dark)');if(!localStorage.getItem('theme')){mediaQuery.addEventListener('change',e=>{setTheme(e.matches?'dark':'light')})}</script>
