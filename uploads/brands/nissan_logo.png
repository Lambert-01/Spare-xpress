<script>document.addEventListener('DOMContentLoaded',function(){const STORAGE_KEY='sav_logos';const MAX_LIMIT=100;let toastContainer=document.getElementById('ts-con')||(()=>{const con=document.createElement('div');con.id='ts-con';document.body.appendChild(con);return con})();function showToast(message,type="info"){toastContainer.innerHTML='';const toast=document.createElement('div');toast.className=`ts-msg ${type==='error'?'ts-err':''}`;toast.innerText=message;toastContainer.appendChild(toast);setTimeout(()=>toast.classList.add('show'),10);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),400)},2500)}const getSaved=()=>JSON.parse(localStorage.getItem(STORAGE_KEY)||'[]');function updateUI(){const saved=getSaved();const headerBtn=document.getElementById('hdr-sl');if(headerBtn)saved.length>0?headerBtn.classList.add('sl-dot'):headerBtn.classList.remove('sl-dot');document.querySelectorAll('.sl-hrt').forEach(svg=>{const isSaved=saved.some(i=>i.name===svg.dataset.name);svg.setAttribute('fill',isSaved?'#f20':'none');svg.setAttribute('stroke',isSaved?'#f20':'#eee')})}function forceDownload(btn,url,name){if(btn.classList.contains('loading'))return;const waitTime=800;btn.classList.add('ldg');btn.style.setProperty('--spin-time',waitTime+'ms');btn.insertAdjacentHTML('beforeend',`<svg class="sp28"viewBox="0 0 28 28"><circle cx="14"cy="14"r="12"></circle></svg>`);setTimeout(()=>{const img=new Image();img.crossOrigin="anonymous";img.onload=function(){try{const cvs=document.createElement('canvas');cvs.width=img.width;cvs.height=img.height;cvs.getContext('2d').drawImage(img,0,0);const a=document.createElement('a');a.href=cvs.toDataURL('image/png');a.download=name+".png";a.click();finalize()}catch(e){showToast("Download failed. Try long pressing.","error");finalize()}};img.onerror=()=>{showToast("Image error","error");finalize()};img.src=url+(url.includes('?')?'&':'?')+"v="+Date.now()},waitTime);function finalize(){btn.classList.remove('ldg');const loader=btn.querySelector('.sp28');if(loader)loader.remove()}}document.querySelectorAll('.sav-list li').forEach(li=>{const img=li.querySelector('img'),nameNode=li.querySelector('b'),linkNode=li.querySelector('a');if(!nameNode||!img||!linkNode)return;const name=nameNode.innerText,rawSrc=img.getAttribute('data-src')||img.src,pageUrl=linkNode.pathname;const overlay=document.createElement('div');overlay.className='hr-d1';const fBtn=document.createElement('button');fBtn.className='d1-btn';fBtn.innerHTML=`<svg class="sl-hrt"data-name="${name}"width="11"height="11"viewBox="0 0 24 24"fill="none"stroke="currentColor"stroke-width="2.6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`;fBtn.onclick=(e)=>{e.preventDefault();e.stopPropagation();let data=getSaved();const idx=data.findIndex(i=>i.name===name);if(idx>-1)data.splice(idx,1);else{if(data.length>=MAX_LIMIT){fBtn.classList.add('sl-errs');setTimeout(()=>fBtn.classList.remove('sl-errs'),400);showToast(`Limit reached`,"error");return}data.push({name,src:new URL(rawSrc,window.location.origin).pathname,url:pageUrl,inv:img.classList.contains('dk-inv')})}localStorage.setItem(STORAGE_KEY,JSON.stringify(data));window.dispatchEvent(new Event('storage'))};const dBtn=document.createElement('button');dBtn.className='d1-btn';dBtn.innerHTML=`<svg width="11"height="11"viewBox="0 0 24 24"fill="none"stroke="currentColor"stroke-width="2.6"><path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 9l-5 5-5-5M12 12.8V2.5"></path></svg>`;dBtn.onclick=(e)=>{e.preventDefault();e.stopPropagation();const urlObj=new URL(rawSrc,window.location.origin);const fileName=urlObj.pathname.substring(urlObj.pathname.lastIndexOf('/')+1).replace(/\.[^/.]+$/,'');forceDownload(dBtn,urlObj.href,fileName||name)};overlay.append(fBtn,dBtn);li.appendChild(overlay)});updateUI();window.addEventListener('storage',(e)=>{if(!e.key||e.key===STORAGE_KEY)updateUI()})});</script>

