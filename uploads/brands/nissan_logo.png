{ans:'Subaru',img:'/car-logos/subaru-logo.png',opts:['Subaru','Mitsubishi','Suzuki','Mazda']},
{ans:'Mercedes-Benz',img:'/car-logos/mercedes-benz-logo.png',opts:['Mercedes-Benz','Audi','BMW','Volvo']},
{ans:'Lexus',img:'/car-logos/lexus-logo.png',opts:['Lexus','Infiniti','Acura','Genesis']},
{ans:'Audi',img:'/car-logos/audi-logo.png',opts:['Audi','Volkswagen','Volvo','Jaguar'],class:"dk-inv"},
{ans:'Lamborghini',img:'/car-logos/lamborghini-logo.png',opts:['Lamborghini','Ferrari','Maserati','McLaren']},
{ans:'Nissan',img:'/car-logos/nissan-logo.png',opts:['Nissan','Infiniti','Toyota','Honda'],class:"dk-inv"},
{ans:'Porsche',img:'/car-logos/porsche-logo.png',opts:['Porsche','Ferrari','Maserati','Lamborghini']},
{ans:'Mazda',img:'/car-logos/mazda-logo.png',opts:['Mazda','Nissan','Mitsubishi','Subaru']},
{ans:'Chevrolet',img:'/car-logos/chevrolet-logo.png',opts:['Chevrolet','Cadillac','Buick','Chrysler']},
{ans:'Volkswagen',img:'/car-logos/volkswagen-logo.png',opts:['Volkswagen','Volvo','Audi','Opel'],class:"dk-inv"},
{ans:'Ferrari',img:'/car-logos/ferrari-logo.png',opts:['Ferrari','Lamborghini','Porsche','Lotus']},
{ans:'Cadillac',img:'/car-logos/cadillac-logo.png',opts:['Cadillac','Lincoln','Genesis','Chrysler'],class:"dk-inv"},
{ans:'Acura',img:'/car-logos/acura-logo.png',opts:['Acura','Lexus','Infiniti','Honda']},
{ans:'Volvo',img:'/car-logos/volvo-logo.png',opts:['Volvo','Buick','Volkswagen','Polestar']},
{ans:'Bugatti',img:'/car-logos/bugatti-logo.png',opts:['Bugatti','Koenigsegg','Pagani','Rimac']},
{ans:'Infiniti',img:'/car-logos/infiniti-logo.png',opts:['Infiniti','Lexus','Acura','Nissan']},
{ans:'Maserati',img:'/car-logos/maserati-logo.png',opts:['Maserati','Ferrari','Alfa Romeo','Bugatti'],class:"dk-inv"},
{ans:'Hyundai',img:'/car-logos/hyundai-logo.png',opts:['Hyundai','Kia','Honda','Mazda']},
{ans:'Aston Martin',img:'/car-logos/aston-martin-logo.png',opts:['Aston Martin','Jaguar','Lotus','McLaren']},
{ans:'Land Rover',img:'/car-logos/land-rover-logo.png',opts:['Land Rover','Jeep','Jaguar','Hummer']},
{ans:'Bentley',img:'/car-logos/bentley-logo.png',opts:['Bentley','Rolls-Royce','Aston Martin','Maybach']},
{ans:'Alfa Romeo',img:'/car-logos/alfa-romeo-logo.png',opts:['Alfa Romeo','Maserati','Lancia','Lotus']},
{ans:'Buick',img:'/car-logos/buick-logo.png',opts:['Buick','Cadillac','Chevrolet','Oldsmobile']},
{ans:'Peugeot',img:'/car-logos/peugeot-logo.png',opts:['Peugeot','Citroën','Renault','Opel']},
{ans:'Rolls-Royce',img:'/car-logos/rolls-royce-logo.png',opts:['Rolls-Royce','Bentley','Maybach','Cadillac']},
{ans:'Opel',img:'/car-logos/opel-logo.png',opts:['Opel','Vauxhall','Citroën','Skoda']},
{ans:'Mini',img:'/car-logos/mini-logo.png',opts:['Mini','Fiat','Smart','Citroën'],class:"dk-inv"},
{ans:'Renault',img:'/car-logos/renault-logo.png',opts:['Renault','Peugeot','Dacia','Fiat']},
{ans:'Lincoln',img:'/car-logos/lincoln-logo.png',opts:['Lincoln','Cadillac','Chrysler','Buick'],class:"dk-inv"},
{ans:'Skoda',img:'/car-logos/skoda-logo.png',opts:['Skoda','Volkswagen','Seat','Opel']}
];
let cur=0,score=0,first=true,mistakes={},pool=[],conf=null;function init(){if(!conf){const cvs=document.getElementById('tpw0');if(typeof confetti!=='undefined'){conf=cvs?confetti.create(cvs,{resize:true}):confetti}else{conf=null}}pool=[...quizData].sort(()=>Math.random()-0.5).slice(0,5);cur=0;score=0;mistakes={};render()}function render(){first=true;const itm=pool[cur],tot=pool.length,nx=document.getElementById('ju4a');const imgEl=document.getElementById('p1aq');imgEl.src=itm.img;imgEl.className=itm.class||'';document.getElementById('e012').className='e012';nx.classList.remove('show');nx.innerText=(cur===tot-1)?"GET SCORE \u2192":"NEXT \u2192";document.getElementById('nk5i').innerText=`${cur+1}/${tot}`;document.getElementById('p225').style.width=`${((cur+1)/tot)*100}%`;const gd=document.getElementById('hy7g');gd.innerHTML='';[...itm.opts].sort(()=>Math.random()-0.5).forEach(o=>{const b=document.createElement('button');b.className='opt4';b.innerText=o;b.onclick=()=>{if(o===itm.ans){if(first)score++;b.classList.add('ok');document.getElementById('e012').classList.add('rev');nx.classList.add('show');if(conf)conf({particleCount:20,spread:40,origin:{y:0.8}});Array.from(gd.children).forEach(el=>{el.disabled=true;if(el!==b)el.style.opacity="0.3"})}else{first=false;mistakes[itm.ans]=(mistakes[itm.ans]||0)+1;b.classList.add('no');b.disabled=true}};gd.appendChild(b)})}function nextQ(e){if(e)e.preventDefault();cur<pool.length-1?(cur++,render()):done()}function done(){document.getElementById('w9u7').classList.remove('t43d');document.getElementById('blc6').classList.add('t43d');document.getElementById('gs10').innerText=`${Math.round((score/pool.length)*100)}%`;let ar=document.getElementById('rg8d'),m=Object.entries(mistakes).sort((a,b)=>b[1]-a[1]);ar.innerHTML=m.length?`<p style="font-size:13px;color:#AAA;margin-bottom:10px;font-weight:600">Wrong List</p>`:`<p style="font-size:16px;color:#4CAF50;font-weight:700;text-align:center">&#127942;&nbsp;&nbsp;PERFECT!</p>`;m.forEach(([n,c])=>{ar.innerHTML+=`<div class="wlit ${c>=2?'hd':''}"><span>${n}</span>${c}${c===1?'&nbsp;try':'&nbsp;tries'}</div>`});if(conf)conf({particleCount:150,spread:100,origin:{y:0.5}})}function reset(){document.getElementById('blc6').classList.remove('t43d');document.getElementById('w9u7').classList.add('t43d');init()}document.addEventListener('DOMContentLoaded',init);
</script>

