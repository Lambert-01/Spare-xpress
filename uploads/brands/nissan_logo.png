<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
const quizData=[
{ans:'Tesla',img:'/car-logos/tesla-logo.png',opts:['Tesla','Polestar','Toyota','Lucid']},
{ans:'Toyota',img:'/car-logos/toyota-logo.png',opts:['Toyota','Honda','Nissan','Subaru'],class:"dk-inv"},
{ans:'Honda',img:'/car-logos/honda-logo.png',opts:['Honda','Hyundai','Toyota','Suzuki']},
{ans:'BMW',img:'/car-logos/bmw-logo.png',opts:['BMW','Mercedes-Benz','Audi','Mini']},
